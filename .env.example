# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Firebase (web SDK, public) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Local development against the emulators (npm run emulators)
NEXT_PUBLIC_FIREBASE_USE_EMULATOR=0

# ---------- Firebase Admin (server) ----------
FIREBASE_PROJECT_ID=
# Service account JSON on one line, or base64 of it. Leave empty with the emulators.
FIREBASE_SERVICE_ACCOUNT=
# Emulators (leave empty in production)
FIRESTORE_EMULATOR_HOST=
FIREBASE_AUTH_EMULATOR_HOST=

# ---------- Claude ----------
ANTHROPIC_API_KEY=
# 1 = run the pipeline with deterministic local logic (never in production)
SHORTLIST_AI_MOCK=0
SHORTLIST_MODEL_EXTRACT=claude-haiku-4-5
SHORTLIST_MODEL_REWRITE=claude-sonnet-5
SHORTLIST_MODEL_PREMIUM=claude-opus-5

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 1 = grant purchases without payment (development only, ignored in production)
SHORTLIST_DEV_CHECKOUT=0
# 1 = let Stripe Tax add HST at checkout (configure tax in the Stripe dashboard first)
STRIPE_AUTOMATIC_TAX=0

# ---------- Salary data ----------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---------- Email ----------
RESEND_API_KEY=
EMAIL_FROM=Shortlist <hello@shortlist.ca>
